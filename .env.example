# Copy to .env and adjust. The server does not load .env itself:
#   node --env-file=.env server/index.js     (Node 20.6+)
# or set the variables in your shell before `npm run dev`.

# Port for the local server (Vite live reload always uses 4318 in development).
PORT=4317

# Folder for the local notebook (state.json) and optional seed files.
CHESSBUDDY_DATA_DIR=./data

# Only for migrating old single-account data (data/import.ndjson, data/rating-history.json).
# Leave blank for new installs.
CHESSBUDDY_LEGACY_USERNAME=
